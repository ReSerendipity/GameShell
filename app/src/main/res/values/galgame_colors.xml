<?xml version="1.0" encoding="utf-8"?>
<!-- GameShell 闪屏底色。暗档不另起 key，由 values-night/galgame_colors.xml 覆盖同名
     galgame_splash_background（主题走 setDefaultNightMode + -night 资源限定）。 -->
<resources>
    <!-- 亮档用 G34O 定稿底色 #F5F7FA；暗档覆盖为 swiss_paper #0E0E0E -->
    <color name="galgame_splash_background">#FFF5F7FA</color>

    <!-- Swiss grid（04 视觉语言）：黑白纸面 + 单点红，无卡片无阴影 -->
    <color name="swiss_paper">#FFFFFFFF</color>
    <color name="swiss_ink">#FF111111</color>
    <color name="swiss_red">#FFE4002B</color>
    <color name="swiss_line">#FF111111</color>
    <color name="swiss_hairline">#1F000000</color>
    <color name="swiss_muted">#FF6E6E6E</color>
    <color name="swiss_faint">#FF9A9A9A</color>
    <color name="swiss_pressed">#FFF2F2F2</color>
    <color name="swiss_count">#33000000</color>
</resources>
