<?xml version="1.0" encoding="utf-8"?>
<!-- GameShell 冷启动闪屏（亮档）：G34O 浅灰白底 + 居中弦线窥圆字形（彩色前景）。
     注意一：这里刻意用字面量颜色而非 ?attr——上游 AppThemeBase 的 windowBackground
     引用主题属性时实测解析失败（窗口退化为纯黑）。
     注意二：暗档不靠第二套主题，改由 drawable-night/galgame_splash.xml + values-night
     覆盖同名底色实现（原 GalgameMainThemeDark 无人引用，已删）。
     注意三：运行时 AppUtils.setActivityTheme 会把窗口背景换成 GalgameSwissTheme 的纯色
     swiss_paper，所以本 drawable 实际只作用于「预览窗口」——Pixel 等标准启动器会显示它，
     ColorOS 用图标放大动画取代预览窗口、故在其上不可见。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/galgame_splash_background" />
    <item
        android:width="132dp"
        android:height="132dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
